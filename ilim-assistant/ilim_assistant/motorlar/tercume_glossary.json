      "match": ["nakshibandi", "nakşibendi", "naqshbandi", "bahaeddin", "bahauddin", "makamat", "makamât", "rufai", "rifai"],
      "rules": [
        "Nakşibendi silsilesinde isim ve makam terimlerini koru.",
        "Makam = manevi mertebe; günlük «mekan» anlamına indirgeme."
