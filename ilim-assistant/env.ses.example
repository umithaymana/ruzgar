# Rüzgar Ses Motoru — isteğe bağlı ortam değişkenleri (Faz S1–S4)
# Kopyala: .env veya sistem ortamına ekle

# --- STT (Faz S2) ---
# RUZGAR_WHISPER_MODEL=small
# RUZGAR_WHISPER_DEVICE=cpu
# RUZGAR_STT_MAX_SEC=7200

# --- Prosody (Faz S1) ---
# RUZGAR_TTS_PROSODY=1
# RUZGAR_TTS_PROSODY_MIN=70

# --- Ses klonlama XTTS (Faz S4) ---
# RUZGAR_TTS_CLONE=1
# RUZGAR_TTS_CLONE_MAX_CHARS=2500
# RUZGAR_ILIM_VOICE_ROOT=../ilim-voice
# RUZGAR_SES_REFERANS_DIR=ilim-assistant/arsiv/ses-referans
# XTTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
# --- Dublaj (Faz S6) ---
# RUZGAR_VIDEO_DUB=1
# RUZGAR_DUB_MAX_SEG=48
# RUZGAR_DUB_MAX_SEC=900
#
# --- Tilavet (Faz S5) ---
# RUZGAR_TTS_TILAVET=1
# RUZGAR_TTS_TILAVET_CLONE=1
# RUZGAR_TTS_AR_VOICE=ar-SA-HamedNeural
# RUZGAR_TTS_TR_ALIM_VOICE=tr-TR-AhmetNeural
#
# Videodan referans (sohbet: «videodaki sesi kuran sesi yap»):
#   ilim-assistant/arsiv/ses-referans/kuran.wav | gazel.wav | ilahi.wav
#
# Kurulum (CPU yavaş; GPU önerilir):
#   pip install TTS torch soundfile
# veya: pip install -r ilim-voice/requirements-tts.txt
