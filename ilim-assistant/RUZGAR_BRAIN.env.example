# Rüzgar — tam yerel Ollama şablonu (Gemini/Groq yok)

RUZGAR_SUPER_BRAIN=1
RUZGAR_BRAIN_PROFILE=auto

# --- Yalnızca yerel (bağımsız) ---
RUZGAR_OLLAMA_ONLY=1
RUZGAR_DISABLE_GEMINI=1
RUZGAR_DISABLE_GROQ=1
RUZGAR_FREE_BRAIN=1
RUZGAR_BRAIN_FALLBACK_CHAIN=denge,hizli,kod
RUZGAR_GEMINI_DAEMON=0
RUZGAR_FAST_BILGI_GEMINI=0
RUZGAR_CASUAL_FAST_GEMINI=0
RUZGAR_TARIH_GEMINI_FIRST=0

OLLAMA_API_BASE=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama
# En güçlü (RAM ~40GB+): llama3.1:70b | Orta: llama3.1:8b | Hafif: llama3.2:3b
OLLAMA_CHAT_MODEL=llama3.1:70b
RUZGAR_BRAIN_DENGE_MODEL=llama3.1:70b
RUZGAR_BRAIN_HIZLI_MODEL=llama3.2:3b
RUZGAR_BRAIN_KOD_MODEL=llama3.1:70b
RUZGAR_OLLAMA_READ_TIMEOUT_SEC=900

# Bulut (kapalı — açmak için RUZGAR_OLLAMA_ONLY=0 ve anahtar ekleyin)
# GLOBAL_API_KEY=
# GROQ_API_KEY=
