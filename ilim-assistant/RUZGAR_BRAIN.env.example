# Rüzgar Süper Beyin — ortam değişkenleri şablonu
# Bu dosyayı kopyalayıp .env yapın veya sistem ortamına ekleyin.

# --- Genel ---
RUZGAR_SUPER_BRAIN=1
RUZGAR_BRAIN_PROFILE=auto

# --- Google Gemini (ücretsiz geliştirici kotası) ---
# Anahtar: https://aistudio.google.com/apikey
GOOGLE_GEMINI_API_KEY=
RUZGAR_GEMINI_MODEL=gemini-2.0-flash
RUZGAR_GEMINI_MAX_OUTPUT_TOKENS=4096
RUZGAR_GEMINI_TEMPERATURE=0.35
# Gemini ilk tokenı geciktirirse Rüzgar takılı kalmasın; yedek modele düşer.
RUZGAR_GEMINI_CONNECT_TIMEOUT_SEC=8
RUZGAR_GEMINI_READ_TIMEOUT_SEC=18

# Alternatif anahtar adları (isteğe bağlı):
# GEMINI_API_KEY=
# RUZGAR_GEMINI_API_KEY=

# --- Yerel Ollama (yedek / hızlı profiller) ---
OLLAMA_API_BASE=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_CHAT_MODEL=llama3.1:8b
RUZGAR_BRAIN_HIZLI_MODEL=llama3.2:3b
RUZGAR_BRAIN_DENGE_MODEL=llama3.1:8b

# Programlama modunda Gemini kullanmak için:
# RUZGAR_BRAIN_KOD_USE_GEMINI=1
# RUZGAR_BRAIN_KOD_MODEL=gemini-2.0-flash

# Yedek sıra (virgülle): gemini,denge,hizli,kod
# RUZGAR_BRAIN_FALLBACK_CHAIN=gemini,denge,hizli

# Eski OpenAI değişkenleri artık kullanılmıyor.
# Bulut = yalnızca Google Gemini (GOOGLE_GEMINI_API_KEY).

# --- Faz 9 — bilgi/tarih hız (Ana Motor + retrieval) ---
# «Kim kurdu» vb. ansiklopedik soruda bilgi skorunu yükseltir (varsayılan açık).
# RUZGAR_FAZ9_ENCYCLOPEDIC_BILGI_BOOST=0
# Gemini anahtarı varken bu sorularda yerel indeks + web'i tamamen atlar.
# RUZGAR_FAZ9_GEMINI_FIRST_FOR_FACTS=0
# `bilim` plânı kalsa bile Gemini anahtarı varken aynı desende arşiv turunu atlar.
# RUZGAR_FAZ9_BILIM_FAST_INDEX=0

# --- Faz 9 — chat_core tarih yolu (prepare_turn) ---
# Ansiklopedik soruda prefetch bundle'ı korur; bundle yoksa tarih+tarih_hafiza taramasını kısaltır.
# RUZGAR_FAZ9_CHAT_CORE_TARIH_LIGHT=0
# RUZGAR_FAZ9_TARIH_POOL_K_CAP=12
# RUZGAR_FAZ9_TARIH_SCAN_CAP=40
# RUZGAR_FAZ9_TARIH_TOP_K=3

# Masaüstü API: `coding_mode: true` ise mod her zaman programlama sayılır (tam indeks kapalı).
# Gemini SSE toplam süre tavanı (saniye); aşılırsa Ollama yedek zincirine düşülür.
# RUZGAR_GEMINI_STREAM_MAX_SEC=45
# `/api/system-metrics`: CPU için `psutil` (requirements.txt); GPU için `nvidia-smi` PATH’te olmalı.

# --- Faz 10 — programlama otonom debug (masaüstü API, programlama modu) ---
# Mesajda «otomatik debug», «debug döngüsü», «traceback'i düzelt» vb. geçerse:
# LLM cevabındaki @@write uygulanır, pytest çalışır; kırmızıysa RUZGAR_CODE_DEBUG_LOOPS
# kadar ek LLM turu (Faz 10.4–10.6). 0 = yalnızca bir kez doğrula, tekrar yok.
# RUZGAR_CODE_DEBUG_LOOPS=2
# RUZGAR_CODE_DEBUG_AUTO=0
