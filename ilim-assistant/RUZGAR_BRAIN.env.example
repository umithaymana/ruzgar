# Rüzgar Süper Beyin — ortam değişkenleri şablonu
# Bu dosyayı kopyalayıp .env yapın veya sistem ortamına ekleyin.

# --- Genel ---
RUZGAR_SUPER_BRAIN=1
RUZGAR_BRAIN_PROFILE=auto

# --- Ücretsiz beyin önceliği (önerilen) ---
# 1) Yerel Ollama (sınırsız, gizlilik)  2) Groq (isteğe)  3) Gemini (kota)
RUZGAR_FREE_BRAIN=1
RUZGAR_GEMINI_ONLY=0
RUZGAR_BRAIN_FALLBACK_CHAIN=denge,hizli,groq,gemini
RUZGAR_CASUAL_FAST_GEMINI=0
# Bilgi/hafıza: ağır RAG yerine doğrudan beyin zinciri (ansiklopedik + kısa bilgi)
RUZGAR_FAST_PATHS=1
# Bilgi: 0 = once Ollama/Groq (kota toleransi), 1 = once Gemini dene
RUZGAR_FAST_BILGI_GEMINI=0
# Kota/hiz siniri sonrasi Gemini'yi atla (saniye, varsayilan 2700 = 45 dk)
RUZGAR_GEMINI_COOLDOWN=1
RUZGAR_GEMINI_COOLDOWN_SEC=2700

# --- Google Gemini (ücretsiz geliştirici kotası) ---
# Anahtar: https://aistudio.google.com/apikey
# Kalıcı (önerilen): ilim-assistant/.env → GLOBAL_API_KEY
GLOBAL_API_KEY=
# Eski ad (isteğe bağlı; GLOBAL_API_KEY yoksa okunur):
# GOOGLE_GEMINI_API_KEY=
RUZGAR_GEMINI_MODEL=gemini-2.0-flash
RUZGAR_GEMINI_MAX_OUTPUT_TOKENS=4096
RUZGAR_GEMINI_TEMPERATURE=0.35
# Gemini ilk tokenı geciktirirse Rüzgar takılı kalmasın; yedek modele düşer.
RUZGAR_GEMINI_CONNECT_TIMEOUT_SEC=8
RUZGAR_GEMINI_READ_TIMEOUT_SEC=18

# Alternatif anahtar adları (isteğe bağlı):
# GEMINI_API_KEY=
# RUZGAR_GEMINI_API_KEY=

# --- Yerel Ollama (birincil — tamamen ücretsiz) ---
# Kurulum: https://ollama.com → ollama pull llama3.2:3b → ollama serve
OLLAMA_API_BASE=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_CHAT_MODEL=llama3.2:3b
RUZGAR_BRAIN_HIZLI_MODEL=llama3.2:3b
RUZGAR_BRAIN_DENGE_MODEL=llama3.2:3b

# --- Groq (isteğe bağlı ücretsiz bulut, OpenAI uyumlu) ---
# https://console.groq.com → API Keys
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
# GROQ_API_BASE=https://api.groq.com/openai/v1

# Programlama modunda Gemini kullanmak için:
# RUZGAR_BRAIN_KOD_USE_GEMINI=1
# RUZGAR_BRAIN_KOD_MODEL=gemini-2.0-flash

# Yedek sıra (virgülle): gemini,denge,hizli,kod
# RUZGAR_BRAIN_FALLBACK_CHAIN=gemini,denge,hizli

# Eski OpenAI değişkenleri artık kullanılmıyor.
# Bulut = Google Gemini (GLOBAL_API_KEY → otomatik GOOGLE_GEMINI_* alias).
# Arka plan bağlantı: RUZGAR_GEMINI_DAEMON=1  RUZGAR_GEMINI_DAEMON_INTERVAL_SEC=90

# --- Faz 9 — bilgi/tarih hız (Ana Motor + retrieval) ---
# «Kim kurdu» vb. ansiklopedik soruda bilgi skorunu yükseltir (varsayılan açık).
# RUZGAR_FAZ9_ENCYCLOPEDIC_BILGI_BOOST=0
# Gemini anahtarı varken bu sorularda yerel indeks + web'i tamamen atlar.
# RUZGAR_FAZ9_GEMINI_FIRST_FOR_FACTS=0
# Ansiklopedik soruda yerel atlama (eski davranış): RUZGAR_FAZ9_GEMINI_SKIP_LOCAL=1
# Hızlı arşiv/indeks top_k: RUZGAR_ENCYCLOPEDIC_AR_K=2  RUZGAR_ENCYCLOPEDIC_INDEX_K=3

# --- Ana Motor Süper Beyin (bilgi/ilim tam cevap) ---
# RUZGAR_ANA_MOTOR_SUPER_DIRECTIVE=0
# RUZGAR_ANA_MOTOR_REFLECTION=0
# RUZGAR_KAYNAK_CHUNK_MAX=2400
# `bilim` plânı kalsa bile Gemini anahtarı varken aynı desende arşiv turunu atlar.
# RUZGAR_FAZ9_BILIM_FAST_INDEX=0

# --- Faz 9 — chat_core tarih yolu (prepare_turn) ---
# Ansiklopedik soruda prefetch bundle'ı korur; bundle yoksa tarih+tarih_hafiza taramasını kısaltır.
# RUZGAR_FAZ9_CHAT_CORE_TARIH_LIGHT=0
# RUZGAR_FAZ9_TARIH_POOL_K_CAP=12
# RUZGAR_FAZ9_TARIH_SCAN_CAP=40
# RUZGAR_FAZ9_TARIH_TOP_K=3

# Masaüstü API: `coding_mode: true` ise mod her zaman programlama sayılır (tam indeks kapalı).
# Gemini SSE toplam süre tavanı (saniye); aşılırsa Ollama yedek zincirine düşülür.
# RUZGAR_GEMINI_STREAM_MAX_SEC=45
# `/api/system-metrics`: CPU için `psutil` (requirements.txt); GPU için `nvidia-smi` PATH’te olmalı.

# --- Faz 11 — idrak yüzey ön-işlemi (LLM yok, birleşik yazım vb.) ---
# RUZGAR_IDRAK_PRETREAT=0
# Kısa devam ifadeleri ("devam et", "öyle yap") son sohbet bağlamı ile genişletilir.

# --- Faz 13/14/16 — kişisel hafıza, self-test ve görev yöneticisi ---
# Hafıza komutları: "hatırla: ...", "unut: ...", "profilimi göster"
# Self-test: GET /api/self-test
# Görevler: GET/POST /api/tasks, POST /api/tasks/update

# --- Faz 10 — programlama otonom debug (masaüstü API, programlama modu) ---
# Mesajda «otomatik debug», «debug döngüsü», «traceback'i düzelt» vb. geçerse:
# LLM cevabındaki @@write uygulanır, pytest çalışır; kırmızıysa RUZGAR_CODE_DEBUG_LOOPS
# kadar ek LLM turu (Faz 10.4–10.6). 0 = yalnızca bir kez doğrula, tekrar yok.
# RUZGAR_CODE_DEBUG_LOOPS=2
# RUZGAR_CODE_DEBUG_AUTO=0
# Başarısız pytest sonrası özet: hafiza/son_debug_raporu.txt + GET /api/system-health-report

# --- Oturum kalıcı hafıza → her turda LLM context (prepare_turn) ---
# RUZGAR_SESSION_MEMORY_CONTEXT=0
# RUZGAR_SESSION_PERSONAL_LIMIT=8
# RUZGAR_SESSION_SHARED_LIMIT=8
# RUZGAR_SESSION_TASK_LIMIT=6
# RUZGAR_SESSION_REMINDER_LIMIT=5

# --- Masaüstü sohbet taşıması ---
# Varsayılan UI: streaming kapalı; POST /api/chat/full (tek JSON, ~60 sn istemci timeout).
# Eski yol: POST /api/chat/stream veya WS /ws/chat
