# Kopyala: RUZGAR_BRAIN.env — anahtarları buraya yapıştır (git'e ekleme)
# Gemini: https://aistudio.google.com/apikey
# Groq (yedek): https://console.groq.com

GLOBAL_API_KEY=AIzaSy...
GROQ_API_KEY=gsk_...

# Bulut modu için .env örneği: RUZGAR_OLLAMA_ONLY=0, RUZGAR_GEMINI_ONLY=1

# Rüzgar Virüs Kalkanı (birincil motor — internet indirme, varsayılan açık)
# RUZGAR_VIRUS_GUARD=1
# RUZGAR_VIRUS_GUARD_MAX_MB=2048
# YouTube temiz taramada sesli onayı atla (varsayılan: 1)
# RUZGAR_VIRUS_GUARD_VIDEO_AUTO_APPROVE=1
# YouTube bot engeli — tarayıcı çerezleri (Windows varsayılan: edge)
# RUZGAR_YTDLP_COOKIES_BROWSER=edge
# RUZGAR_YTDLP_COOKIES_BROWSER=chrome
# RUZGAR_YTDLP_COOKIES_BROWSER=0
# RUZGAR_AV_CLAM_SUPPORT=0
# RUZGAR_AV_DEFENDER_BACKUP=0
