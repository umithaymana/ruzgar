# Kopyala: RUZGAR_BRAIN.env — anahtarları buraya yapıştır (git'e ekleme)
# Gemini: https://aistudio.google.com/apikey
# Groq (yedek): https://console.groq.com

GLOBAL_API_KEY=AIzaSy...
GROQ_API_KEY=gsk_...

# Bulut modu için .env örneği: RUZGAR_OLLAMA_ONLY=0, RUZGAR_GEMINI_ONLY=1

# Ana Motor Faz B (varsayılan açık)
# RUZGAR_ANA_MOTOR_SENTEZ=1
# RUZGAR_ANA_MOTOR_PROG_HAVUZ=1
# RUZGAR_ANA_MOTOR_REFLECTION=1
# RUZGAR_SENTEZ_SOURCE_MAX=6000
# kimdir/nedir — ogretilmis tek cumle yerine Ana Motor (varsayilan acik)
# RUZGAR_EGITIM_SKIP_BILGI_INSTANT=1
# bilgi/liste sorulari tarih_fast yerine Ana Motor (varsayilan acik)
# RUZGAR_TARIH_FAST_SKIP_BILGI=1

# Faz C — arastirma raporu + guncellik + bilgi zinciri
# RUZGAR_ANA_MOTOR_ARASTIRMA=1
# RUZGAR_WEB_FRESHNESS_STAMP=1
# RUZGAR_REPLY_FRESHNESS_STAMP=1
# RUZGAR_BILGI_BRAIN_CHAIN=gemini,groq,denge,hizli
# RUZGAR_LIVE_BILGI_SLO_SEC=75

# Faz D — bilim derin / 70B / otonom debug
# RUZGAR_BILIM_DERIN=1
# RUZGAR_BILIM_DERIN_RAG_TOP_K=8
# RUZGAR_BILIM_DERIN_USE_70B=1
# RUZGAR_BRAIN_DENGE70_MODEL=llama3.1:70b
# RUZGAR_BRAIN_PROFILE=denge-70b
# RUZGAR_ANA_MOTOR_OTONOM_DEBUG=1

# Faz E — SLO, 70B hazirlik, canli progress
# RUZGAR_LIVE_BILIM_DERIN_SLO_SEC=120
# RUZGAR_DENGE70_REQUIRE_PULLED=1
# RUZGAR_ANA_PROGRESS_ETA=1
# RUZGAR_ANA_MOTOR_PATCH_APPROVAL=1
# RUZGAR_ARASTIRMA_NEBULA_CARD=1

# Faz F — dosya ingest / nebula oneri / kaynak matrisi
# RUZGAR_ANA_MOTOR_UPLOAD_INGEST=1
# RUZGAR_ANA_UPLOAD_MAX_BYTES=8388608
# RUZGAR_ANA_MOTOR_NEBULA_ONERI=1
# RUZGAR_ANA_MOTOR_KAYNAK_MATRIS=1

# Faz G — oturum paketi / nebula apply / canli SLO
# RUZGAR_ANA_UPLOAD_SESSION=1
# RUZGAR_ANA_UPLOAD_SESSION_MAX=6
# RUZGAR_ANA_MOTOR_NEBULA_APPLY=1
# RUZGAR_LIVE_UPLOAD_MATRIS_SLO_SEC=90

# Faz H — nebula bg indeks / oturum hatırla / upload tarama
# RUZGAR_NEBULA_APPLY_BG=1
# RUZGAR_ANA_SESSION_REMEMBER=1
# RUZGAR_ANA_UPLOAD_VIRUS_SCAN=1

# Faz I — paket sihirbazı / arşiv / TTL / canlı indeks SLO
# RUZGAR_ANA_PAKET_SIHIRBAZ=1
# RUZGAR_ANA_UPLOAD_ARCHIVE=1
# RUZGAR_ANA_UPLOAD_TTL_EXTEND=1
# RUZGAR_ANA_UPLOAD_TTL_EXTEND_SEC=86400
# RUZGAR_LIVE_NEBULA_INDEX_SLO_SEC=300

# Faz J — otomatik paket / arşiv restore / oturum merge
# RUZGAR_ANA_PAKET_AUTO=1
# RUZGAR_ANA_ARCHIVE_RESTORE=1
# RUZGAR_ANA_SESSION_MERGE=1

# Faz K — paket özet kartı / oturum nebula öneri / TTL hatırlatıcı
# RUZGAR_ANA_PAKET_OZET=1
# RUZGAR_ANA_SESSION_NEBULA_ONERI=1
# RUZGAR_ANA_ARCHIVE_TTL_REMIND=1
# RUZGAR_ANA_UPLOAD_REMIND_SEC=3600
# RUZGAR_ANA_ARCHIVE_REMIND_DAYS=30

# Faz L — hatırlatıcı paket / özet nebula apply / oturum timeline
# RUZGAR_ANA_REMINDER_WIZARD=1
# RUZGAR_ANA_OZET_NEBULA_APPLY=1
# RUZGAR_ANA_SESSION_TIMELINE=1

# Faz M — timeline aksiyon / bildirim / paket CSV
# RUZGAR_ANA_TIMELINE_ACTIONS=1
# RUZGAR_ANA_REMIND_DESKTOP=1
# RUZGAR_ANA_REMIND_EMAIL=0
# RUZGAR_SMTP_HOST=
# RUZGAR_SMTP_PORT=587
# RUZGAR_SMTP_USER=
# RUZGAR_SMTP_PASS=
# RUZGAR_REMIND_EMAIL_TO=
# RUZGAR_ANA_PAKET_CSV_EXPORT=1

# Faz N — CSV toplu restore / bildirim tercih / paket grafik
# RUZGAR_ANA_CSV_BULK_RESTORE=1
# RUZGAR_ANA_CSV_BULK_MAX=8
# RUZGAR_ANA_NOTIFY_PREFS=1
# RUZGAR_ANA_PAKET_GRAFIK=1

# Faz O — CSV toplu paket / bildirim geçmişi / timeline filtre
# RUZGAR_ANA_CSV_BULK_PAKET=1
# RUZGAR_ANA_CSV_BULK_PAKET_MAX=5
# RUZGAR_ANA_NOTIFY_HISTORY=1
# RUZGAR_ANA_NOTIFY_HISTORY_LIMIT=20
# RUZGAR_ANA_TIMELINE_FILTER=1

# Faz P — JSON/PDF export / bildirim export / haftalık özet
# RUZGAR_ANA_PAKET_JSON_EXPORT=1
# RUZGAR_ANA_PAKET_PDF_EXPORT=1
# RUZGAR_ANA_NOTIFY_HISTORY_EXPORT=1
# RUZGAR_ANA_WEEKLY_SUMMARY=1
# RUZGAR_ANA_WEEKLY_SUMMARY_DAYS=7

# Faz Q — haftalık bildirim / karşılaştırma / timeline hatırla
# RUZGAR_ANA_WEEKLY_NOTIFY=1
# RUZGAR_ANA_WEEKLY_NOTIFY_COOLDOWN_SEC=604800
# RUZGAR_ANA_PAKET_COMPARE=1
# RUZGAR_ANA_PAKET_COMPARE_DAYS=7
# RUZGAR_ANA_TIMELINE_REMEMBER=1
# RUZGAR_ANA_TIMELINE_REMEMBER_MAX=5

# Faz R — compare chart / hatırla geçmişi / haftalık zamanlayıcı
# RUZGAR_ANA_COMPARE_CHART=1
# RUZGAR_ANA_REMEMBER_HISTORY=1
# RUZGAR_ANA_REMEMBER_HISTORY_LIMIT=20
# RUZGAR_ANA_WEEKLY_SCHEDULE=1
# RUZGAR_ANA_WEEKLY_SCHEDULE_POLL_SEC=3600

# Faz S — compare export / hatırla export / schedule prefs
# RUZGAR_ANA_COMPARE_EXPORT=1
# RUZGAR_ANA_REMEMBER_HISTORY_EXPORT=1
# RUZGAR_ANA_SCHEDULE_PREFS=1

# Faz T — süper özet PDF / birleşik tercih / karşılaştırma e-posta
# RUZGAR_ANA_SUPER_OZET_PDF=1
# RUZGAR_ANA_UNIFIED_PREFS=1
# RUZGAR_ANA_COMPARE_EMAIL=1
# RUZGAR_ANA_COMPARE_EMAIL_COOLDOWN_SEC=604800

# Faz U — süper özet e-posta / tercih export / dashboard HTML
# RUZGAR_ANA_SUPER_OZET_EMAIL=1
# RUZGAR_ANA_SUPER_OZET_EMAIL_COOLDOWN_SEC=604800
# RUZGAR_ANA_UNIFIED_PREFS_EXPORT=1
# RUZGAR_ANA_DASHBOARD_HTML=1

# Faz V — birleşik e-posta / dashboard PDF / tam tercih yedek
# RUZGAR_ANA_BIRLESIK_EMAIL=1
# RUZGAR_ANA_BIRLESIK_EMAIL_COOLDOWN_SEC=604800
# RUZGAR_ANA_DASHBOARD_PDF=1
# RUZGAR_ANA_TAM_PREFS_YEDEK=1

# Faz W — tek sohbetten backend motor yürütme
# RUZGAR_ANA_BACKEND_YURUT=1
# RUZGAR_ANA_TERCUME_INSTANT=1
# RUZGAR_ANA_TERCUME_INSTANT_MAX_CHARS=500
# RUZGAR_ANA_VIDEO_URL_INFO=1

# Rüzgar Virüs Kalkanı (birincil motor — internet indirme, varsayılan açık)
# RUZGAR_VIRUS_GUARD=1
# RUZGAR_VIRUS_GUARD_MAX_MB=2048
# YouTube temiz taramada sesli onayı atla (varsayılan: 1)
# RUZGAR_VIRUS_GUARD_VIDEO_AUTO_APPROVE=1
# YouTube bot engeli — tarayıcı çerezleri (Windows varsayılan: edge)
# RUZGAR_YTDLP_COOKIES_BROWSER=edge
# RUZGAR_YTDLP_COOKIES_BROWSER=chrome
# RUZGAR_YTDLP_COOKIES_BROWSER=0
# RUZGAR_AV_CLAM_SUPPORT=0
# RUZGAR_AV_DEFENDER_BACKUP=0
