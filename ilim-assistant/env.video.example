# Rüzgar — Video oluştur (V7.2 / V8) isteğe bağlı anahtarlar
# Otomatik kurulum: powershell -ExecutionPolicy Bypass -File ilim-assistant/scripts/Install-RuzgarVideoExtras.ps1

# V7.2 — Konuşan portre (SadTalker)
# RUZGAR_SADTALKER_ROOT=C:/AI/SadTalker
# RUZGAR_SADTALKER_PYTHON=python
# RUZGAR_SADTALKER_ENHANCER=gfpgan
# RUZGAR_PORTRAIT_TIMEOUT=900
# Özel komut şablonu: {python} {image} {audio} {output_dir} {output}
# RUZGAR_PORTRAIT_CMD=

# V8 — Runway image-to-video
# RUNWAY_API_KEY=
# RUNWAYML_API_SECRET=
# RUZGAR_RUNWAY_MODEL=gen4_turbo
# RUZGAR_RUNWAY_API_BASE=https://api.dev.runwayml.com
# RUZGAR_RUNWAY_POLL_SEC=4
