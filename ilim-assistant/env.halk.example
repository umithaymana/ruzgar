# Rüzgar — halka açık API (Railway / Fly.io / Render)
# Kopyala: env.halk.example → platform ortam değişkenleri

RUZGAR_PUBLIC_MODE=1
RUZGAR_DATA_ROOT=/app/data
RUZGAR_SHARED_ROOT=/app
RUZGAR_RAG_INDEX_DIR=/app/.rag_index

# İsteğe bağlı: lisanslı arşiv alt kümesi (volume veya sync sonrası)
# RUZGAR_SHARED_ARSIV_ROOT=/app/arsiv

# CORS — web/mobil istemci farklı origin'den bağlanacaksa
RUZGAR_CORS_PERMISSIVE=1

# Beyin zinciri (bulutta Ollama yoksa Gemini/Groq anahtarları gerekir)
# GEMINI_API_KEY=
# GROQ_API_KEY=
RUZGAR_GENEL_LOCAL_FIRST=0

# RAG
RAG_TOP_K=2
RAG_INDEX_CACHE=1

# Port — Railway/Render PORT otomatik okunur
# RUZGAR_API_PORT=8777
